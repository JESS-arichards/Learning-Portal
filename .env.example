PORT=8081
PUBLIC_BASE_URL=http://localhost:5174
APPLICATIONS_PORTAL_URL=http://localhost:8080
# Set LEARNING_PORTAL_URL=http://localhost:5174 in Applications Portal.
# Same value as PLATFORM_LEARN_KEY in Applications Portal; at least 32 characters.
PLATFORM_API_KEY=
# Independent from Applications Portal; at least 32 characters.
SESSION_SECRET=
SQL_SERVER=
SQL_DATABASE=
# SQL authentication required; no managed identity.
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false
# Opt in per webapp only for Azure SQL serverless auto-pause. Normal SQL defaults unchanged.
SQL_SERVERLESS_ENABLED=false
# Enable only on the DEVELOPMENT web app for the explicitly confirmed admin reset.
ALLOW_SCHEDULE_RESET=false
# Reuse the existing Entra app registration credentials on this web app.
# Register PUBLIC_BASE_URL + /api/teams/callback as a Web redirect URI.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Enables Teams; canonical base64 of 32 random bytes. Keep stable for stored connections.
TEAMS_TOKEN_KEY=
# Alternatively set SQL_CONNECTION_STRING with User ID and Password (SQL auth only).
AZURE_STORAGE_CONNECTION_STRING=
# HTTPS storage account connection string containing AccountName and AccountKey.
AZURE_STORAGE_CONTAINER=learning-files
